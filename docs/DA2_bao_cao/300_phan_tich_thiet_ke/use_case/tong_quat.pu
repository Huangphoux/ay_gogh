@startuml Tổng quát

left to right direction

actor "Người dùng cá nhân" as fc

rectangle "Ay Gogh!" {
  usecase "Quản lí tài khoản" as UC1
  usecase "Kiểm tra vốn từ vựng" as UC2
  usecase "Đọc sách" as UC3
  usecase "Thu thập từ vựng" as UC4
  usecase "Chỉnh thông số thuật toán" as UC5
  usecase "Trò chơi" as UC6
  usecase "Tính năng trò chơi hoá" as UC7
  usecase "Tìm kiếm trong văn bản" as UC8
}

fc --> UC1
fc --> UC2
fc --> UC3
fc --> UC4
fc --> UC5
fc --> UC6
fc --> UC7
fc --> UC8

@enduml